{
    "name": "ofeliaengine",
    "displayName": "ofeliaengine",
    "description": "Debug an ofeliaengine game's Luau scripts: attach to the editor's Play or to a player started with --debug, with breakpoints, steps, the stack, variables and evaluation.",
    "version": "0.2.0",
    "publisher": "ofeliaengine",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Debuggers"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onDebugResolve:ofeliaengine",
        "onDebugInitialConfigurations"
    ],
    "contributes": {
        "breakpoints": [
            {
                "language": "luau"
            },
            {
                "language": "lua"
            }
        ],
        "debuggers": [
            {
                "type": "ofeliaengine",
                "label": "ofeliaengine",
                "languages": [
                    "luau",
                    "lua"
                ],
                "configurationAttributes": {
                    "attach": {
                        "properties": {
                            "target": {
                                "type": "string",
                                "enum": [
                                    "editor",
                                    "player"
                                ],
                                "enumDescriptions": [
                                    "The editor that has the game open: the scripts it plays.",
                                    "A player of the game started with --debug (a development build): the newest, or one picked from a list."
                                ],
                                "description": "What to attach to.",
                                "default": "editor"
                            },
                            "play": {
                                "type": "boolean",
                                "description": "Play the open scene in the editor when attached, and stop it when the session ends.",
                                "default": false
                            },
                            "endpoint": {
                                "type": "string",
                                "description": "The file the editor or a player writes its port and token to (.ofelia/debug/editor.json, player-<pid>.json); without it, found by the target."
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "ofeliaengine",
                        "request": "attach",
                        "name": "Attach to the editor"
                    },
                    {
                        "type": "ofeliaengine",
                        "request": "attach",
                        "name": "Attach and Play",
                        "play": true
                    },
                    {
                        "type": "ofeliaengine",
                        "request": "attach",
                        "name": "Attach to the player",
                        "target": "player"
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "ofeliaengine: Attach to the editor",
                        "description": "Debug the scripts the editor plays",
                        "body": {
                            "type": "ofeliaengine",
                            "request": "attach",
                            "name": "Attach to the editor"
                        }
                    },
                    {
                        "label": "ofeliaengine: Attach and Play",
                        "description": "Play the scene in the editor and debug its scripts",
                        "body": {
                            "type": "ofeliaengine",
                            "request": "attach",
                            "name": "Attach and Play",
                            "play": true
                        }
                    },
                    {
                        "label": "ofeliaengine: Attach to the player",
                        "description": "Debug the scripts of a player started with --debug",
                        "body": {
                            "type": "ofeliaengine",
                            "request": "attach",
                            "name": "Attach to the player",
                            "target": "player"
                        }
                    }
                ]
            }
        ]
    }
}
